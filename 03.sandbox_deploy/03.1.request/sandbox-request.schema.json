{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonmap.net/schemas/sandbox-request-v2.schema.json",
  "title": "Sandbox task request (full state)",
  "description": "과제 1개의 '원하는 전체 상태'. 신규·변경·이관 모두 같은 형식이며, 환경별 값(도메인·프로젝트·영역)은 main.py 가 환경변수로 검사한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "approval",
    "action",
    "task",
    "identity",
    "project",
    "data",
    "gke",
    "workload",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9-]{6,64}$"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approval_id",
        "approved_at"
      ],
      "properties": {
        "status": {
          "const": "APPROVED"
        },
        "approval_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "action": {
      "enum": [
        "CREATE",
        "UPDATE"
      ],
      "description": "CREATE=최초 적용, UPDATE=기존 과제의 전체 상태 재적용(중지·기동·증설·이미지 교체). 삭제는 지원하지 않는다."
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "display_name",
        "expires_on",
        "origin"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,19}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "expires_on": {
          "type": "string",
          "format": "date"
        },
        "origin": {
          "enum": [
            "NEW",
            "MIGRATED"
          ],
          "description": "MIGRATED=기존 VM 과제. 그룹·프로젝트·데이터는 건드리지 않고 기존 디스크를 PV 로 붙인다."
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_email",
        "manage_group",
        "jupyter_gsa"
      ],
      "properties": {
        "group_email": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
        },
        "manage_group": {
          "type": "boolean",
          "description": "true 면 05-group 단계가 그룹·멤버십을 관리한다."
        },
        "members": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
          }
        },
        "group_resource_name": {
          "type": "string",
          "pattern": "^groups/[A-Za-z0-9_-]+$"
        },
        "membership_resource_names": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^groups/[A-Za-z0-9_-]+/memberships/[A-Za-z0-9_-]+$"
          }
        },
        "jupyter_gsa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "email",
            "create"
          ],
          "properties": {
            "email": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$",
              "description": "Pod 이 Workload Identity 로 사용할 과제 프로젝트의 서비스 계정."
            },
            "create": {
              "type": "boolean",
              "description": "true 면 40-data 단계가 생성. 기존 VM SA 재사용은 false."
            }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manage",
        "project_id"
      ],
      "properties": {
        "manage": {
          "type": "boolean",
          "description": "true 면 10-project · 30-project-iam 단계를 실행."
        },
        "create_project": {
          "type": "boolean",
          "default": false
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
        },
        "project_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30
        },
        "folder_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "billing_account": {
          "type": "string",
          "pattern": "^[0-9A-F]{6}-[0-9A-F]{6}-[0-9A-F]{6}$"
        },
        "org_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "manage": {
                "const": true
              }
            },
            "required": [
              "manage"
            ]
          },
          "then": {
            "required": [
              "create_project",
              "project_name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "create_project": {
                "const": true
              }
            },
            "required": [
              "create_project"
            ]
          },
          "then": {
            "required": [
              "billing_account"
            ],
            "properties": {
              "manage": {
                "const": true
              }
            },
            "oneOf": [
              {
                "required": [
                  "folder_id"
                ],
                "not": {
                  "required": [
                    "org_id"
                  ]
                }
              },
              {
                "required": [
                  "org_id"
                ],
                "not": {
                  "required": [
                    "folder_id"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manage"
      ],
      "properties": {
        "manage": {
          "type": "boolean",
          "description": "true 면 40-data 단계(BQ·GCS·데이터 IAM)를 실행."
        },
        "bigquery_dataset": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,1023}$"
        },
        "gcs_bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$"
        },
        "adopt_existing_resources": {
          "type": "boolean",
          "default": false
        },
        "datalake_datasets": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "project_id",
              "dataset_id"
            ],
            "properties": {
              "project_id": {
                "type": "string"
              },
              "dataset_id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,1023}$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "manage": {
                "const": true
              }
            },
            "required": [
              "manage"
            ]
          },
          "then": {
            "required": [
              "bigquery_dataset",
              "gcs_bucket"
            ]
          }
        }
      ]
    },
    "gke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "cluster_name",
        "location"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "cluster_name": {
          "type": "string"
        },
        "location": {
          "type": "string",
          "pattern": "^[a-z]+-[a-z]+[0-9]$"
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area",
        "namespace",
        "running",
        "cpu",
        "memory_gib",
        "storage",
        "containers"
      ],
      "properties": {
        "area": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,15}$",
          "description": "영역. 허용값은 ALLOWED_AREAS 환경변수."
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,62}$"
        },
        "running": {
          "type": "boolean",
          "description": "false 면 replicas=0 (중지). 디스크는 유지된다."
        },
        "cpu": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "memory_gib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "ephemeral_storage_gib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 10
        },
        "compute_class": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]{0,62}$",
          "default": "Balanced"
        },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "count"
          ],
          "properties": {
            "type": {
              "type": "string",
              "pattern": "^nvidia-[a-z0-9-]+$"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          }
        },
        "hub_config": {
          "enum": [
            "MANAGED",
            "IMAGE"
          ],
          "default": "MANAGED",
          "description": "MANAGED=저장소의 jupyterhub_config 템플릿을 마운트. IMAGE=이미지 안의 설정을 그대로 사용."
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size_gb",
            "zone"
          ],
          "properties": {
            "size_gb": {
              "type": "integer",
              "minimum": 10,
              "maximum": 4000
            },
            "zone": {
              "type": "string",
              "pattern": "^[a-z]+-[a-z]+[0-9]-[a-z]$"
            },
            "existing_disk": {
              "type": "string",
              "pattern": "^[a-z]([-a-z0-9]{0,61}[a-z0-9])?$",
              "description": "GKE 프로젝트에 이미 만들어 둔 PD 이름(스냅샷에서 복원). 있으면 정적 PV 로 붙인다."
            },
            "storage_class": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
            }
          }
        },
        "containers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "image",
              "hub_port",
              "host",
              "base_path"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z]([-a-z0-9]{0,30}[a-z0-9])?$"
              },
              "image": {
                "type": "string",
                "pattern": "^[a-z0-9./_:-]+@sha256:[0-9a-f]{64}$",
                "description": "digest 고정 이미지."
              },
              "hub_port": {
                "type": "integer",
                "minimum": 8080,
                "maximum": 8089
              },
              "host": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
              },
              "base_path": {
                "type": "string",
                "pattern": "^/([a-z0-9-]+/)*$",
                "description": "'/' 면 호스트 방식, 그 외는 경로 방식 (JupyterHub base_url)."
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "archive_uri",
        "generation",
        "sha256"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{3,64}$"
        },
        "archive_uri": {
          "type": "string",
          "pattern": "^gs://[a-z0-9._-]+/.+\\.zip$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
